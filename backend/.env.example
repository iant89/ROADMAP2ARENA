MONGO_URL=mongodb://localhost:27017
DB_NAME=your_db_name
ARENA2API_URL=http://localhost:9090
ARENA2API_MODEL=gpt-4o
ARENA_STEP_DELAY_SECONDS=2
ARENA_REQUEST_TIMEOUT_SECONDS=300
CORS_ORIGINS=*
GITHUB_OAUTH_CLIENT_ID=
# Fernet key that encrypts the GitHub token at rest (required to connect GitHub from Settings).
# Generate: /app/venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes a stored token unreadable - reconnect GitHub afterwards.
R2A_SECRET_KEY=
# Optional: a GitHub token here overrides the one saved in Settings.
R2A_GITHUB_TOKEN=
# Poll interval for pushed branches / PRs / CI (default 60, minimum 30). Keep uvicorn at --workers 1.
R2A_GITHUB_POLL_SECONDS=60
# Runtime data (job git repos under <dir>/repos). Default: <repo root>/data - keep it OUTSIDE
# backend/ so uvicorn --reload never sees job files. Old backend/data/repos is moved here on startup.
R2A_DATA_DIR=
