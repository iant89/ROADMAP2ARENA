# Optional settings for ./run-gateway.sh. Copy to gateway/.env; it is Git-ignored.
# Do not expose this service publicly: upstream extension push/status are NOT authenticated.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9090
GATEWAY_LOG_LEVEL=info
# Optional Bearer key for /v1/models and /v1/chat/completions only.
# If set, put the SAME value in ARENA2API_API_KEY in backend/.env.
# Never put Arena cookies, auth tokens, or reCAPTCHA tokens in this file or in Git.
GATEWAY_API_KEY=
